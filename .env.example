# MLflow tracking and registry location (a sqlite:/// URI needs no server).
MLOPS_TRACKING_URI=
# Registered model name to serve.
MLOPS_MODEL_NAME=
# Registry alias that marks the model to serve.
MLOPS_MODEL_ALIAS=
# SQLite file where every prediction is logged.
MLOPS_PREDLOG_PATH=
# Reference data the monitor compares live windows against.
MLOPS_REFERENCE_PATH=
# Folder where incident postmortems are written.
MLOPS_POSTMORTEM_DIR=
# Slack incoming-webhook URL; leave empty to print incidents as JSON lines instead.
MLOPS_SLACK_WEBHOOK_URL=
